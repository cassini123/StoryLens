{
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": ".vercel-dist",
  "installCommand": "cd CHItest && npm ci",
  "framework": null,
  "trailingSlash": true,
  "regions": ["hnd1"],
  "functions": {
    "api/jimeng.js": {
      "maxDuration": 30
    },
    "api/chitest-session.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/CHItest", "destination": "/chitest/", "permanent": false },
    { "source": "/CHItest/", "destination": "/chitest/", "permanent": false },
    { "source": "/CHItest/:path*", "destination": "/chitest/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/jimeng/", "destination": "/api/jimeng" },
    { "source": "/api/chitest-session/", "destination": "/api/chitest-session" }
  ]
}
