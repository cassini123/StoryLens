{
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": ".vercel-dist",
  "installCommand": "cd CHItest && npm ci",
  "framework": null,
  "trailingSlash": true,
  "regions": ["hnd1"],
  "functions": {
    "api/jimeng.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    { "source": "/CHItest", "destination": "/chitest/", "permanent": false },
    { "source": "/CHItest/", "destination": "/chitest/", "permanent": false },
    { "source": "/CHItest/:path*", "destination": "/chitest/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/jimeng/", "destination": "/api/jimeng" }
  ],
  "headers": [
    {
      "source": "/chitest",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/chitest/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/chitest/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ]
}
